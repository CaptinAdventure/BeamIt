#include <windows.h>
#include "TrayHostResources.h"

IDD_CONNECTION_PASSWORD DIALOGEX 0, 0, 310, 119
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Change connection password"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Connection password (changes apply only until BeamIt exits):", -1, 10, 10, 290, 12
    EDITTEXT IDC_CONNECTION_PASSWORD, 10, 28, 290, 16, ES_AUTOHSCROLL | ES_PASSWORD
    CONTROL "Show password", IDC_SHOW_PASSWORD, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 51, 115, 14
    PUSHBUTTON "Generate password", IDC_GENERATE_PASSWORD, 190, 50, 110, 16
    LTEXT "Copy this password to your client. It is never saved or logged.", -1, 10, 73, 290, 12
    DEFPUSHBUTTON "OK", IDOK, 190, 94, 52, 16
    PUSHBUTTON "Cancel", IDCANCEL, 248, 94, 52, 16
END

IDD_HOST_STATISTICS DIALOGEX 0, 0, 520, 340
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
CAPTION "BeamIt - Statistics"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "", IDC_INPUT_ELEVATION, 10, 10, 500, 32
    EDITTEXT IDC_HOST_STATISTICS, 10, 48, 500, 256,
        ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP
    LTEXT "Metrics are sampled every 10 seconds; this view refreshes every second.", -1, 10, 315, 430, 14
    DEFPUSHBUTTON "Close", IDCANCEL, 458, 313, 52, 16
END
