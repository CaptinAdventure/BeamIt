[Version]
Signature="$Windows NT$"
Class=MEDIA
ClassGUID={4d36e96c-e325-11ce-bfc1-08002be10318}
Provider=%Provider%
DriverVer=10/22/2026,0.2.0.0
CatalogFile=BeamItMicrophone.cat
PnpLockdown=1

[Manufacturer]
%Provider%=Models,NTamd64.10.0...22000

[Models.NTamd64.10.0...22000]
%DeviceName%=Microphone,Root\BeamItMicrophone

[SourceDisksNames]
1=%DiskName%

[SourceDisksFiles]
BeamItMicDriver.sys=1

[DestinationDirs]
DriverCopy=13

[DriverCopy]
BeamItMicDriver.sys

[Microphone.NT]
Include=ks.inf,wdmaudio.inf
Needs=KS.Registration,WDMAUDIO.Registration
CopyFiles=DriverCopy
AddReg=DriverRegistry

[DriverRegistry]
HKR,,AssociatedFilters,,"wdmaud"
HKR,,Driver,,BeamItMicDriver.sys
HKR,Drivers,SubClasses,,"wave,mixer"
HKR,Drivers\wave\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\wave\wdmaud.drv,Description,,%DeviceName%
HKR,Drivers\mixer\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\mixer\wdmaud.drv,Description,,%DeviceName%
HKR,MediaCategories\{25cefe60-79bf-4192-b043-172cdbdd0480},Name,,%DeviceName%

[Microphone.NT.Services]
AddService=BeamItMicDriver,0x00000002,DriverService

[DriverService]
DisplayName=%DeviceName%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\BeamItMicDriver.sys

[Microphone.NT.Interfaces]
AddInterface=%Audio%,WaveMic,WaveInterface
AddInterface=%Capture%,WaveMic,WaveInterface
AddInterface=%Realtime%,WaveMic,WaveInterface
AddInterface=%Audio%,TopologyMic,TopologyInterface
AddInterface=%Topology%,TopologyMic,TopologyInterface

[WaveInterface]
AddReg=WaveRegistry

[WaveRegistry]
HKR,,CLSID,,%Proxy%
HKR,,FriendlyName,,%DeviceName%

[TopologyInterface]
AddReg=TopologyRegistry

[TopologyRegistry]
HKR,,CLSID,,%Proxy%
HKR,,FriendlyName,,%DeviceName%
HKR,EP\0,%Association%,,%AnyNode%
HKR,EP\0,%EventDriven%,0x00010001,1

